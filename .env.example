# Identifiants de connexion (change ces valeurs avant tout déploiement public)
AUTH_USERNAME="admin"
AUTH_PASSWORD="changeme123"

# Secret utilisé pour signer les cookies de session — mets une longue chaîne
# aléatoire propre à toi. La changer déconnecte tous les utilisateurs.
SESSION_SECRET="change-this-to-a-long-random-string"

# Emplacement du fichier de base de données SQLite
DATABASE_PATH="./data/flotte.db"

# Port d'écoute du serveur
PORT=3000

# v4.31 — Assistant IA (Google Gemini, offre gratuite)
# Facultatif : la clé peut aussi être collée dans l'application (bouton Assistant → réglages, superadmin).
# Obtenir une clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
