{
  "id": "/port",
  "name": "YM-TRANSIT — Sorties port",
  "short_name": "YMT Port",
  "description": "Saisie des sorties de camions au port par l'agent YM-TRANSIT",
  "start_url": "/port?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#0f1f3a",
  "theme_color": "#0f1f3a",
  "lang": "fr",
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/port-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/port-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/port-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ajouter un camion", "short_name": "Ajouter", "url": "/port?action=add", "icons": [{ "src": "/icons/port-192.png", "sizes": "192x192" }] },
    { "name": "Fiche du jour", "short_name": "Aujourd'hui", "url": "/port", "icons": [{ "src": "/icons/port-192.png", "sizes": "192x192" }] }
  ]
}
